# API Configuration
# Para desenvolvimento local, use o proxy do Vite (deixe vazio ou use '/api/v1')
# Para produção, use a URL completa do backend: https://seu-backend.com/api/v1
VITE_API_URL=/api/v1

# Exemplo para produção:
# VITE_API_URL=https://api.lanature.com/api/v1

# Exemplo para desenvolvimento com backend em outra porta:
# VITE_API_URL=http://localhost:8000/api/v1
